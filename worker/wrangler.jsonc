// The leaderboard API (worker/src/index.ts). Deployed by hand from this
// folder: `npm run deploy`. Its one secret, the Google service account's
// JSON key, is set with `npx wrangler secret put GCP_SERVICE_ACCOUNT` and
// never goes in the repo. The marketplace's removals (milestone 24) need a
// second secret, the developer's code: `npx wrangler secret put DEV_CODE`.
// See worker/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parklaps-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // ALLOWED_ORIGINS: every Firebase site in firebase.json (web.app and firebaseapp.com) plus GitHub Pages.
  "vars": {
    "PROJECT_ID": "parklaps-3b60f",
    "STORE": "firestore",
    "ALLOWED_ORIGINS": "https://parklaps.web.app,https://parklaps.firebaseapp.com,https://parklaps-ski.web.app,https://parklaps-ski.firebaseapp.com,https://playparklaps.web.app,https://playparklaps.firebaseapp.com,https://parklapsgame.web.app,https://parklapsgame.firebaseapp.com,https://parklaps-snow.web.app,https://parklaps-snow.firebaseapp.com,https://parklaps-shred.web.app,https://parklaps-shred.firebaseapp.com,https://spasecases.github.io"
  },
  // Per address, per minute. A classroom shares one address, so these are loose (READS also
  // covers multiplayer's lobby lists and joins: a class of 40 joining and rejoining fits).
  "ratelimits": [
    { "name": "READS", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITES", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    // The developer's code (marketplace removals): a few tries a minute.
    { "name": "DEV", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  // Multiplayer (milestone 27): one Durable Object per room, SQLite-backed (the only kind on Workers Free).
  // One per lobby (room.ts), and one list of open lobbies per map (lobbies.ts).
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "LOBBIES", "class_name": "Lobbies" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Lobbies"] }],
  // Once a day: marketplace items hidden by reports a week ago come back (worker/src/market.ts restoreHidden).
  "triggers": { "crons": ["17 9 * * *"] }
}
