rules_version = '2';

// The online leaderboards and saved looks (GAME_DESIGN.md, milestone 13) are
// reached only through the leaderboard Worker (worker/, a Cloudflare
// Worker). It signs in as a Google service account, and requests made that
// way are allowed by IAM and never see these rules. So the rules shut every
// other request out: nobody can read or write the database directly, from
// the game or by hand. The Worker checks what the old rules did (names,
// boards, ranges, the look's shape and sizes, an entry only ever getting
// better) and adds the word filter and rate limits.
//
//   boards/<board>/names/<key>, looks/<key>          the real ones
//   testBoards/<board>/names/<key>, testLooks/<key>  play-tests (?boards=test)
//
// Deployed by hand, only after the Worker is live (worker/README.md):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
